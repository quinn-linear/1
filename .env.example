# Linear OAuth application credentials (https://linear.app/settings/api/applications/new).
# Callback URL to register: <your origin>/api/auth/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Optional: public origin for canonical URLs and share previews, e.g. https://wrapped.example.com
# (https only; defaults to the Vercel deployment URL, then http://localhost:3000). Set at build time.
SITE_URL=
